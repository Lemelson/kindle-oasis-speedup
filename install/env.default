# kppfast env switches (KPP*=value, safe characters only; launch.sh exports them, never sources this file)
# libkppx11.so: XPutImage/XGetImage through MIT-SHM (falls back to 0666 segments only on BadAccess)
KPPX11_SHMPUT=1
KPPX11_SHMGET=1
# libkppfs.so: stat memo for /mnt/us (TTL ms) + ENOENT memo for fixed missing config paths
KPPFS_STAT=1
KPPFS_TTL_MS=1000
KPPFS_NEG=1
# userspace clock: off until CNTVCT is verified on the device
KPPFS_CLOCK=0
